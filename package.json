{
	"type": "module",
	"name": "toneriko-script",
	"version": "2.0.0-alpha.1",
	"description": "Toneriko Script, a fork of AiScript for Misskey (Toneriko)",
	"author": "syuilo <syuilotan@yahoo.co.jp>",
	"license": "MIT",
	"private": true,
	"homepage": "https://github.com/toneriko-dev/toneriko-script",
	"exports": {
		".": {
			"import": "./built/index.js",
			"types": "./built/index.d.ts"
		},
		"./*": {
			"import": "./built/*",
			"types": "./built/*"
		}
	},
	"scripts": {
		"build": "tsdown",
		"watch": "tsdown --watch",
		"typecheck": "bun check",
		"lint": "bun run --bun typecheck",
		"test": "vitest run",
		"start": "bun ./scripts/start.mjs",
		"parse": "bun ./scripts/parse.mjs",
		"repl": "bun ./scripts/repl.mjs",
		"gen-pkg": "bun ./scripts/gen-pkg-ts.mjs"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"fast-check": "4.9.0",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"typescript-js": "npm:typescript@6.0.3",
		"vitest": "5.0.3"
	},
	"files": [
		"built"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/toneriko-dev/toneriko-script.git"
	}
}
